# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# When running locally without docker, use a local Postgres:
#   DATABASE_URL=postgres://course:coursepw@localhost:5432/courseplatform
# Inside docker compose the host is 'db':
#   DATABASE_URL=postgres://course:coursepw@db:5432/courseplatform
DATABASE_URL=postgres://course:coursepw@localhost:5432/courseplatform

# Postgres credentials used by docker-compose (the 'db' service initialises
# itself from these on first run)
POSTGRES_USER=course
POSTGRES_PASSWORD=coursepw
POSTGRES_DB=courseplatform

# Test database connection (E2E + db unit tests). Falls back to DATABASE_URL.
# Each test creates its own ephemeral schema and drops it on completion.
# TEST_DATABASE_URL=postgres://course:coursepw@localhost:5432/courseplatform

# Security
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
SESSION_SECRET=another-long-random-string

# Admin Bootstrap (used by scripts/init-admin.js the first time)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Site
SITE_NAME=My Course Hub
SITE_URL=http://localhost:3000

# ---- Payments: Razorpay (the single automated payment path) ----------------
# Get these from Razorpay Dashboard -> Settings -> API Keys.
# Leave BLANK for local "dev bypass" mode (checkout auto-completes without real
# payment) so you can click through the flow without keys. In production set all
# three; the webhook secret is set when you create the webhook (see below).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks -> add {SITE_URL}/api/payments/webhook,
# subscribe to payment.captured + order.paid, and paste the signing secret here.
RAZORPAY_WEBHOOK_SECRET=

# Number of videos to render at once (CPU-bound). 1 is safe for small servers.
RENDER_CONCURRENCY=1

# ---- Object storage: OpenStack Swift (buyer photos + rendered videos) -------
# When set, uploaded photos and rendered videos are stored in Swift under the
# SWIFT_PREFIX folder: <prefix>/photos/... and <prefix>/renders/...
# Leave blank to store media on local disk (storage/) instead.
SWIFT_AUTH_URL=
SWIFT_APP_CREDENTIAL_ID=
SWIFT_APP_CREDENTIAL_SECRET=
SWIFT_STORAGE_URL=
SWIFT_CONTAINER=
SWIFT_PUBLIC_BASE_URL=
SWIFT_PREFIX=course-sell
# Set true if the Keystone auth host uses a self-signed cert (the auth call only).
SWIFT_AUTH_INSECURE_TLS=false
# Set true only if the Swift storage host also uses a self-signed cert.
SWIFT_STORAGE_INSECURE_TLS=false

# ---- Invite-video pricing tiers -------------------------------------------
# Each template has a tier (low/mid/high). These are the FINAL (discounted)
# prices; the "was" price and "% OFF" badge are derived from the discount below.
# Change these per occasion (e.g. a festival sale) — buyer-facing prices update
# on restart; run `npm run seed:video` to also refresh the stored admin values.
VIDEO_PRICE_LOW=699
VIDEO_PRICE_MID=999
VIDEO_PRICE_HIGH=1299
VIDEO_DISCOUNT_PERCENT=70

# Legacy UPI fields (kept for reference; manual UPI flow has been removed).
UPI_CURRENCY=INR

# Google SMTP (use an App Password from your Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_NAME=My Course Hub
SUPPORT_EMAIL=your-email@gmail.com
