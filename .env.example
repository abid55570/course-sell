# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# When running locally without docker, use a local Postgres:
#   DATABASE_URL=postgres://course:coursepw@localhost:5432/courseplatform
# Inside docker compose the host is 'db':
#   DATABASE_URL=postgres://course:coursepw@db:5432/courseplatform
DATABASE_URL=postgres://course:coursepw@localhost:5432/courseplatform

# Postgres credentials used by docker-compose (the 'db' service initialises
# itself from these on first run)
POSTGRES_USER=course
POSTGRES_PASSWORD=coursepw
POSTGRES_DB=courseplatform

# Test database connection (E2E + db unit tests). Falls back to DATABASE_URL.
# Each test creates its own ephemeral schema and drops it on completion.
# TEST_DATABASE_URL=postgres://course:coursepw@localhost:5432/courseplatform

# Security
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
SESSION_SECRET=another-long-random-string

# Admin Bootstrap (used by scripts/init-admin.js the first time)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Site
SITE_NAME=My Course Hub
SITE_URL=http://localhost:3000

# UPI Payment (your UPI ID e.g. yourname@okhdfcbank)
UPI_ID=yourname@okhdfcbank
UPI_PAYEE_NAME=Your Name
UPI_CURRENCY=INR

# Google SMTP (use an App Password from your Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_NAME=My Course Hub
SUPPORT_EMAIL=your-email@gmail.com
