node_modules
node_modules
node_modules

# Browser automation snapshots and console logs
.playwright-mcp/

# Debug screenshots taken during development
*.png
*.jpeg

# ...but product and blog artwork is real content
!web/public/**/*.png

# Secrets. .env carries the SMTP password, JWT/session secrets and API keys.
# It was previously absent from this file, and a `git add -A` committed it.
.env
.env.local
.env.*.local
!.env.example

# Local scratch that must never ship
_archive/
.superpowers/
*_stdout.log

# Runtime artifacts: uploaded photos and rendered video files. The video
# render e2e test writes here, so they show up as untracked after a test run.
api/storage/photos/
api/storage/renders/

# Paid deliverables. These live OUTSIDE public/ on purpose: anything under
# public/ is served by express.static with no auth, which made every product
# downloadable at a URL guessable from its own slug.
api/storage/deliverables/

# Paid product files. These ARE the product — a buyer pays for them — so they
# must never enter git history, which is public the moment the repo is.
# The admin panel's upload and api/scripts/attach-product-files.js both
# write here. Keep the directory, ignore the contents.
public/uploads/
