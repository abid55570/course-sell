{
  "name": "course-platform",
  "version": "1.0.0",
  "description": "Digital product platform: courses + personalised invite-video generator, Razorpay payments, admin panel, email delivery",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-admin": "node scripts/init-admin.js",
    "migrate": "node scripts/migrate.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:video": "node scripts/seed-video.js",
    "seed:carousel": "node scripts/seed-carousel.js",
    "seed:tools": "node scripts/seed-tools.js",
    "seed:catalog": "node scripts/seed-catalog.js",
    "migrate:catalog": "node scripts/migrate-catalog.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "ffmpeg-static": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
